PORT=5001

# MySQL (relational / transactional data)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=predictive_maintenance

# MongoDB (high-volume telemetry: error logs, risk scores)
MONGO_URI=mongodb://localhost:27017/predictive_maintenance

# Run the risk scoring batch job every N minutes (0 = only on demand)
RISK_BATCH_INTERVAL_MINUTES=0
